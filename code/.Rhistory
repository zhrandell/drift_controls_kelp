# Experimental design figure --------------------------------------------------
# Recreates the spatial treatment schematic for supplementary material.
# Uses base R's grid graphics only.
library(grid)
# ---- Output settings --------------------------------------------------------
out_pdf <- "experimental_design_space_R.pdf"
out_png <- "experimental_design_space_R.png"
# ---- Helper functions -------------------------------------------------------
draw_label_box <- function(x, y, w, h, border = "grey40", lwd = 1,
title, subtitle = NULL, body = NULL,
title_cex = 1.15, body_cex = 0.62,
icon_fun = NULL) {
grid.rect(x, y, w, h, gp = gpar(fill = NA, col = border, lwd = lwd))
left <- x - w / 2 + 0.018
top  <- y + h / 2 - 0.020
grid.text(title, x = left, y = top, just = c("left", "top"),
gp = gpar(fontsize = 18 * title_cex, fontfamily = "Helvetica"))
if (!is.null(subtitle)) {
grid.text(subtitle, x = left, y = top - 0.042, just = c("left", "top"),
gp = gpar(fontsize = 11.5 * body_cex / 0.62,
fontfamily = "Helvetica"))
}
if (!is.null(body)) {
grid.text(body, x = left, y = top - 0.080, just = c("left", "top"),
gp = gpar(fontsize = 11.5 * body_cex / 0.62,
fontfamily = "Helvetica"))
}
if (!is.null(icon_fun)) {
icon_fun(x + w / 2 - 0.050, y, 1)
}
}
draw_urchin <- function(x, y, scale = 1) {
n <- 42
theta <- seq(0, 2 * pi, length.out = n + 1)[-1]
r1 <- 0.0045 * scale
r2 <- 0.021  * scale
for (i in seq_along(theta)) {
grid.segments(
x0 = x + r1 * cos(theta[i]),
y0 = y + r1 * sin(theta[i]),
x1 = x + r2 * cos(theta[i]),
y1 = y + r2 * sin(theta[i]),
gp = gpar(col = rgb(0.26, 0.03, 0.20, 0.55), lwd = 0.7)
)
}
grid.circle(x, y, r = 0.0105 * scale,
gp = gpar(fill = rgb(0.30, 0.02, 0.24, 0.85),
col = rgb(0.18, 0.01, 0.14, 0.85),
lwd = 0.4))
}
draw_kelp_plant <- function(x, y, scale = 1, lean = 0.0,
col_stipe = "#8A8F2A",
col_blade = "#A5AA44") {
# stipe
yy <- seq(0, 1, length.out = 40)
xx <- 0.006 * sin(yy * 2.8 * pi + lean) + 0.006 * yy * lean
grid.lines(x + xx * scale,
y + yy * 0.062 * scale,
gp = gpar(col = col_stipe, lwd = 1.2 * scale))
# blades
blade_pos <- seq(0.25, 0.90, length.out = 6)
for (i in seq_along(blade_pos)) {
bx <- x + (0.006 * sin(blade_pos[i] * 2.8 * pi + lean) +
0.006 * blade_pos[i] * lean) * scale
by <- y + blade_pos[i] * 0.062 * scale
side <- ifelse(i %% 2 == 0, 1, -1)
grid.curve(
x1 = bx, y1 = by,
x2 = bx + side * 0.014 * scale,
y2 = by + 0.012 * scale,
curvature = side * 0.25,
gp = gpar(col = col_blade, lwd = 1.0 * scale),
square = FALSE, inflect = FALSE
)
grid.curve(
x1 = bx, y1 = by,
x2 = bx - side * 0.010 * scale,
y2 = by + 0.008 * scale,
curvature = -side * 0.25,
gp = gpar(col = adjustcolor(col_blade, alpha.f = 0.75),
lwd = 0.8 * scale),
square = FALSE, inflect = FALSE
)
}
}
draw_kelp <- function(x, y, n = 1, scale = 1) {
if (n == 1) {
draw_kelp_plant(x, y, scale = scale, lean = -0.2)
} else {
offsets <- seq(-0.026, 0.026, length.out = n)
leans   <- seq(-0.35, 0.35, length.out = n)
for (i in seq_len(n)) {
draw_kelp_plant(x + offsets[i] * scale, y, scale = scale * 0.92,
lean = leans[i])
}
}
}
draw_cage <- function(x, y, size = 0.052, drift = 0,
kelp_n = 0, urchin = FALSE,
lwd = 1.4) {
# Cage outline
grid.rect(x, y, size, size,
gp = gpar(fill = "white", col = "black", lwd = lwd))
# Drift fill; drawn from bottom up
if (drift > 0) {
drift <- pmax(0, pmin(1, drift))
grid.rect(x, y - size / 2 + (size * drift) / 2,
width = size, height = size * drift,
gp = gpar(fill = "#168FA0", col = NA))
}
# Re-draw cage border above drift
grid.rect(x, y, size, size,
gp = gpar(fill = NA, col = "black", lwd = lwd))
# Kelp
if (kelp_n > 0) {
if (kelp_n == 1) {
draw_kelp(x - size * 0.24, y - size * 0.42,
n = 1, scale = 0.72)
} else {
draw_kelp(x - size * 0.15, y - size * 0.42,
n = 4, scale = 0.56)
}
}
# Urchin
if (urchin) {
draw_urchin(x + size * 0.20, y - size * 0.26, scale = 0.60)
}
}
draw_drift_legend <- function(x, y, w, h) {
grid.rect(x, y, w, h, gp = gpar(fill = NA, col = "#168FA0", lwd = 1))
left <- x - w / 2 + 0.018
top  <- y + h / 2 - 0.018
grid.text("Eight levels of drift algae treatments",
x = left, y = top, just = c("left", "top"),
gp = gpar(fontsize = 16, fontfamily = "Helvetica"))
grid.text(expression(paste("Blades of Giant Kelp (", italic("Macrocystis pyrifera"), ")")),
x = left, y = top - 0.038, just = c("left", "top"),
gp = gpar(fontsize = 11.5, fontfamily = "Helvetica"))
grid.text("Wet weight biomass ranged 10—330g",
x = left, y = top - 0.070, just = c("left", "top"),
gp = gpar(fontsize = 11.5, fontfamily = "Helvetica"))
# Drift gradient blocks
gx <- x + w / 2 - 0.145
gy <- y + 0.002
grid.rect(gx - 0.020, gy - 0.020, 0.050, 0.010,
gp = gpar(fill = "#168FA0", col = NA))
grid.rect(gx + 0.058, gy + 0.010, 0.050, 0.062,
gp = gpar(fill = "#168FA0", col = NA))
grid.text("10g drift", x = gx - 0.020, y = gy - 0.045,
gp = gpar(fontsize = 10.5, fontfamily = "Helvetica"))
grid.text("330g drift", x = gx + 0.058, y = gy - 0.045,
gp = gpar(fontsize = 10.5, fontfamily = "Helvetica"))
}
draw_full_figure <- function() {
grid.newpage()
pushViewport(viewport(xscale = c(0, 1), yscale = c(0, 1)))
# Title
grid.text("Experimental cage treatments across space",
x = 0.055, y = 0.945, just = c("left", "top"),
gp = gpar(fontsize = 18, fontfamily = "Helvetica"))
# Left legend boxes
draw_label_box(
x = 0.225, y = 0.792, w = 0.345, h = 0.115,
border = "#7B4F73",
title = "Sea urchins",
subtitle = "n=10 or n=20 4-5cm purple urchins",
body = expression(paste("(", italic("Strongylocentrotus purpuratus"), ")\nwithin each cage")),
icon_fun = function(x, y, s) draw_urchin(x, y, scale = 0.85)
)
draw_label_box(
x = 0.225, y = 0.635, w = 0.345, h = 0.115,
border = "#9AA756",
title = "“Low” Kelp treatments",
subtitle = expression(paste("One young ", italic("M. pyrifera"), " sporophyte")),
body = "Wet weight biomass ranged 10—130g",
icon_fun = function(x, y, s) draw_kelp(x, y - 0.035, n = 1, scale = 0.90)
)
draw_label_box(
x = 0.225, y = 0.480, w = 0.345, h = 0.115,
border = "#9AA756",
title = "“High” Kelp treatments",
subtitle = expression(paste("Four young ", italic("M. pyrifera"), " sporophytes")),
body = "Wet weight biomass ranged 100—330g",
icon_fun = function(x, y, s) draw_kelp(x, y - 0.035, n = 4, scale = 0.80)
)
# Cage controls label
grid.rect(0.325, 0.302, 0.142, 0.047,
gp = gpar(fill = "white", col = "grey70", lwd = 1))
grid.text("Cage controls", x = 0.325, y = 0.302,
gp = gpar(fontsize = 14, fontfamily = "Helvetica"))
# Drift legend
draw_drift_legend(x = 0.657, y = 0.800, w = 0.465, h = 0.115)
# Main cage array box
grid.rect(0.695, 0.435, 0.540, 0.435,
gp = gpar(fill = NA, col = "#243C43", lwd = 1.3))
# Cages
x0 <- 0.465
dx <- 0.061
size <- 0.052
drift_levels <- seq(0.08, 0.90, length.out = 8)
y_low  <- 0.615
y_high <- 0.462
for (i in 1:8) {
draw_cage(x0 + (i - 1) * dx, y_low,  size = size,
drift = drift_levels[i], kelp_n = 1, urchin = TRUE)
draw_cage(x0 + (i - 1) * dx, y_high, size = size,
drift = drift_levels[i], kelp_n = 4, urchin = TRUE)
}
# Drift labels under first and last cages
grid.text("10g drift", x = x0, y = y_low - 0.052,
gp = gpar(fontsize = 10, fontfamily = "Helvetica"))
grid.text("330g drift", x = x0 + 7 * dx, y = y_low - 0.052,
gp = gpar(fontsize = 10, fontfamily = "Helvetica"))
grid.text("10g drift", x = x0, y = y_high - 0.052,
gp = gpar(fontsize = 10, fontfamily = "Helvetica"))
grid.text("330g drift", x = x0 + 7 * dx, y = y_high - 0.052,
gp = gpar(fontsize = 10, fontfamily = "Helvetica"))
# Control cages
y_ctrl <- 0.305
ctrl_x <- c(0.465, 0.527, 0.589, 0.651)
draw_cage(ctrl_x[1], y_ctrl, size = size, drift = 0.00, kelp_n = 1, urchin = TRUE)
draw_cage(ctrl_x[2], y_ctrl, size = size, drift = 0.00, kelp_n = 4, urchin = TRUE)
draw_cage(ctrl_x[3], y_ctrl, size = size, drift = 0.88, kelp_n = 0, urchin = TRUE)
draw_cage(ctrl_x[4], y_ctrl, size = size, drift = 0.00, kelp_n = 0, urchin = TRUE)
grid.text("Low only;\nno drift", x = ctrl_x[1], y = y_ctrl - 0.063,
gp = gpar(fontsize = 9.5, fontfamily = "Helvetica"))
grid.text("High only;\nno drift", x = ctrl_x[2], y = y_ctrl - 0.063,
gp = gpar(fontsize = 9.5, fontfamily = "Helvetica"))
grid.text("Drift only;\nno Kelp", x = ctrl_x[3], y = y_ctrl - 0.063,
gp = gpar(fontsize = 9.5, fontfamily = "Helvetica"))
grid.text("Urchins only;\nno kelp/drift", x = ctrl_x[4], y = y_ctrl - 0.063,
gp = gpar(fontsize = 9.5, fontfamily = "Helvetica"))
# Cage array label
grid.text("Cage array", x = 0.765, y = 0.315,
just = c("left", "bottom"),
gp = gpar(fontsize = 15, fontfamily = "Helvetica"))
grid.text("n=20 1 x 1 x 0.4m cages\nNot to scale",
x = 0.765, y = 0.260,
just = c("left", "bottom"),
gp = gpar(fontsize = 11, lineheight = 1.15,
fontfamily = "Helvetica"))
popViewport()
}
# ---- Draw to screen ---------------------------------------------------------
draw_full_figure()
# ---- Export -----------------------------------------------------------------
pdf(out_pdf, width = 10, height = 7.5, useDingbats = FALSE)
draw_full_figure()
dev.off()
png(out_png, width = 3200, height = 2400, res = 320)
draw_full_figure()
windows(12,8, record=T)
warnings()
# Experimental design figure --------------------------------------------------
# Revised version: fixes text overlap, removes font warnings,
# thickens kelp, and avoids viewport/pop errors.
library(grid)
out_pdf <- "experimental_design_space_R_revised.pdf"
out_png <- "experimental_design_space_R_revised.png"
# -------------------------------------------------------------------------
# Helper drawing functions
# -------------------------------------------------------------------------
draw_urchin <- function(x, y, scale = 1) {
n <- 44
theta <- seq(0, 2 * pi, length.out = n + 1)[-1]
r1 <- 0.0045 * scale
r2 <- 0.0210 * scale
for (i in seq_along(theta)) {
grid.segments(
x0 = x + r1 * cos(theta[i]),
y0 = y + r1 * sin(theta[i]),
x1 = x + r2 * cos(theta[i]),
y1 = y + r2 * sin(theta[i]),
gp = gpar(col = rgb(0.38, 0.13, 0.32, 0.42), lwd = 0.7)
)
}
grid.circle(
x, y, r = 0.0105 * scale,
gp = gpar(fill = rgb(0.42, 0.08, 0.33, 0.92),
col = rgb(0.28, 0.03, 0.22, 0.95),
lwd = 0.5)
)
}
draw_kelp_plant <- function(x, y, scale = 1, lean = 0,
col_stipe = "#8D9332",
col_blade = "#A4A53E") {
yy <- seq(0, 1, length.out = 60)
xx <- 0.006 * sin(yy * 2.8 * pi + lean) + 0.004 * yy * lean
# thicker stipe
grid.lines(
x + xx * scale,
y + yy * 0.072 * scale,
gp = gpar(col = col_stipe, lwd = 1.7 * scale, lineend = "round")
)
# fuller blades
blade_pos <- seq(0.16, 0.94, length.out = 8)
for (i in seq_along(blade_pos)) {
bx <- x + (0.006 * sin(blade_pos[i] * 2.8 * pi + lean) +
0.004 * blade_pos[i] * lean) * scale
by <- y + blade_pos[i] * 0.072 * scale
side <- ifelse(i %% 2 == 0, 1, -1)
grid.curve(
x1 = bx, y1 = by,
x2 = bx + side * 0.016 * scale,
y2 = by + 0.013 * scale,
curvature = side * 0.33,
square = FALSE, inflect = FALSE,
gp = gpar(col = col_blade, lwd = 1.25 * scale, lineend = "round")
)
grid.curve(
x1 = bx, y1 = by,
x2 = bx - side * 0.010 * scale,
y2 = by + 0.009 * scale,
curvature = -side * 0.22,
square = FALSE, inflect = FALSE,
gp = gpar(col = adjustcolor(col_blade, alpha.f = 0.85),
lwd = 1.0 * scale, lineend = "round")
)
}
}
draw_kelp <- function(x, y, n = 1, scale = 1) {
if (n == 1) {
draw_kelp_plant(x, y, scale = scale, lean = -0.3)
} else {
offsets <- c(-0.022, -0.008, 0.008, 0.022)
leans   <- c(-0.55, -0.15, 0.20, 0.55)
for (i in seq_len(min(n, 4))) {
draw_kelp_plant(x + offsets[i] * scale,
y,
scale = scale * 0.92,
lean  = leans[i])
}
}
}
draw_cage <- function(x, y, size = 0.055, drift = 0,
kelp_n = 0, urchin = FALSE, lwd = 1.5) {
# outer cage
grid.rect(x, y, size, size,
gp = gpar(fill = "white", col = "black", lwd = lwd))
# drift fill
if (drift > 0) {
drift <- pmax(0, pmin(1, drift))
grid.rect(
x,
y - size / 2 + (size * drift) / 2,
width = size,
height = size * drift,
gp = gpar(fill = "#168FA0", col = NA)
)
}
# redraw border on top
grid.rect(x, y, size, size,
gp = gpar(fill = NA, col = "black", lwd = lwd))
# kelp
if (kelp_n > 0) {
if (kelp_n == 1) {
draw_kelp(x - size * 0.24, y - size * 0.42, n = 1, scale = 0.82)
} else {
draw_kelp(x - size * 0.15, y - size * 0.42, n = 4, scale = 0.68)
}
}
# urchin
if (urchin) {
draw_urchin(x + size * 0.19, y - size * 0.25, scale = 0.62)
}
}
draw_label_box <- function(x, y, w, h, border,
title,
line2 = NULL,
line3 = NULL,
title_size = 22,
text_size = 12.5,
icon_fun = NULL) {
grid.rect(x, y, w, h, gp = gpar(fill = NA, col = border, lwd = 1))
left <- x - w/2 + 0.020
top  <- y + h/2 - 0.022
grid.text(title, x = left, y = top, just = c("left", "top"),
gp = gpar(fontsize = title_size))
if (!is.null(line2)) {
grid.text(line2, x = left, y = top - 0.058, just = c("left", "top"),
gp = gpar(fontsize = text_size))
}
if (!is.null(line3)) {
grid.text(line3, x = left, y = top - 0.108, just = c("left", "top"),
gp = gpar(fontsize = text_size))
}
if (!is.null(icon_fun)) {
icon_fun(x + w/2 - 0.050, y - 0.003)
}
}
draw_drift_legend <- function(x, y, w, h) {
grid.rect(x, y, w, h, gp = gpar(fill = NA, col = "#168FA0", lwd = 1))
left <- x - w/2 + 0.020
top  <- y + h/2 - 0.022
grid.text("Eight levels of drift algae treatments",
x = left, y = top, just = c("left", "top"),
gp = gpar(fontsize = 20))
grid.text(expression(paste("Blades of Giant Kelp (", italic("Macrocystis pyrifera"), ")")),
x = left, y = top - 0.050, just = c("left", "top"),
gp = gpar(fontsize = 12.5))
grid.text("Wet weight biomass ranged 10—330g",
x = left, y = top - 0.098, just = c("left", "top"),
gp = gpar(fontsize = 12.5))
# drift example blocks: shifted a little right and up to avoid text collision
gx1 <- x + w/2 - 0.135
gx2 <- x + w/2 - 0.045
gy  <- y + 0.010
grid.rect(gx1, gy - 0.020, 0.055, 0.012, gp = gpar(fill = "#168FA0", col = NA))
grid.rect(gx2, gy + 0.015, 0.055, 0.075, gp = gpar(fill = "#168FA0", col = NA))
grid.text("10g drift",  x = gx1, y = y - h/2 + 0.020, gp = gpar(fontsize = 10.5))
grid.text("330g drift", x = gx2, y = y - h/2 + 0.020, gp = gpar(fontsize = 10.5))
}
# -------------------------------------------------------------------------
# Main figure
# -------------------------------------------------------------------------
draw_full_figure <- function() {
grid.newpage()
# Title
grid.text("Experimental cage treatments across space",
x = 0.02, y = 0.96, just = c("left", "top"),
gp = gpar(fontsize = 26))
# Left boxes (made slightly taller/wider for better spacing)
draw_label_box(
x = 0.200, y = 0.765, w = 0.360, h = 0.145,
border = "#7B4F73",
title = "Sea urchins",
line2 = "n=10 or n=20 4–5cm purple urchins",
line3 = expression(paste("(", italic("Strongylocentrotus purpuratus"), ") within each cage")),
title_size = 26,
text_size = 14,
icon_fun = function(ix, iy) draw_urchin(ix, iy, scale = 0.90)
)
draw_label_box(
x = 0.200, y = 0.560, w = 0.360, h = 0.145,
border = "#9AA756",
title = "“Low” Kelp treatments",
line2 = expression(paste("One young ", italic("M. pyrifera"), " sporophyte")),
line3 = "Wet weight biomass ranged 10—130g",
title_size = 24,
text_size = 14,
icon_fun = function(ix, iy) draw_kelp(ix, iy - 0.045, n = 1, scale = 1.05)
)
draw_label_box(
x = 0.200, y = 0.365, w = 0.360, h = 0.145,
border = "#9AA756",
title = "“High” Kelp treatments",
line2 = expression(paste("Four young ", italic("M. pyrifera"), " sporophytes")),
line3 = "Wet weight biomass ranged 100—330g",
title_size = 22,
text_size = 13.5,
icon_fun = function(ix, iy) draw_kelp(ix, iy - 0.045, n = 4, scale = 0.95)
)
# Controls label
grid.rect(0.300, 0.165, 0.150, 0.055,
gp = gpar(fill = "white", col = "grey70", lwd = 1))
grid.text("Cage controls", x = 0.300, y = 0.165,
gp = gpar(fontsize = 16))
# Drift legend box (taller)
draw_drift_legend(x = 0.635, y = 0.770, w = 0.490, h = 0.145)
# Main cage array container
grid.rect(0.685, 0.395, 0.565, 0.500,
gp = gpar(fill = NA, col = "#2D454A", lwd = 1.4))
# Treatment cages
x0 <- 0.425
dx <- 0.065
size <- 0.055
drift_levels <- seq(0.08, 0.92, length.out = 8)
y_low  <- 0.585
y_high <- 0.400
for (i in 1:8) {
draw_cage(x0 + (i - 1) * dx, y_low,
size = size, drift = drift_levels[i], kelp_n = 1, urchin = TRUE)
draw_cage(x0 + (i - 1) * dx, y_high,
size = size, drift = drift_levels[i], kelp_n = 4, urchin = TRUE)
}
# drift labels
grid.text("10g drift",  x = x0,          y = y_low  - 0.055, gp = gpar(fontsize = 11))
grid.text("330g drift", x = x0 + 7 * dx, y = y_low  - 0.055, gp = gpar(fontsize = 11))
grid.text("10g drift",  x = x0,          y = y_high - 0.055, gp = gpar(fontsize = 11))
grid.text("330g drift", x = x0 + 7 * dx, y = y_high - 0.055, gp = gpar(fontsize = 11))
# Control cages
y_ctrl <- 0.175
ctrl_x <- c(0.425, 0.490, 0.555, 0.620)
draw_cage(ctrl_x[1], y_ctrl, size = size, drift = 0.00, kelp_n = 1, urchin = TRUE)
draw_cage(ctrl_x[2], y_ctrl, size = size, drift = 0.00, kelp_n = 4, urchin = TRUE)
draw_cage(ctrl_x[3], y_ctrl, size = size, drift = 0.90, kelp_n = 0, urchin = TRUE)
draw_cage(ctrl_x[4], y_ctrl, size = size, drift = 0.00, kelp_n = 0, urchin = TRUE)
grid.text("Low only;\nno drift", x = ctrl_x[1], y = y_ctrl - 0.062, gp = gpar(fontsize = 10.5))
grid.text("High only;\nno drift", x = ctrl_x[2], y = y_ctrl - 0.062, gp = gpar(fontsize = 10.5))
grid.text("Drift only;\nno Kelp", x = ctrl_x[3], y = y_ctrl - 0.062, gp = gpar(fontsize = 10.5))
grid.text("Urchins only;\nno kelp/drift", x = ctrl_x[4], y = y_ctrl - 0.062, gp = gpar(fontsize = 10.5))
# Cage array annotation
grid.text("Cage array", x = 0.765, y = 0.205, just = c("left", "bottom"),
gp = gpar(fontsize = 20))
grid.text("n=20 1 x 1 x 0.4m cages", x = 0.765, y = 0.165, just = c("left", "bottom"),
gp = gpar(fontsize = 14))
grid.text("Not to scale", x = 0.765, y = 0.125, just = c("left", "bottom"),
gp = gpar(fontsize = 14))
}
# -------------------------------------------------------------------------
# Draw to screen
# -------------------------------------------------------------------------
draw_full_figure()
# -------------------------------------------------------------------------
# Export
# -------------------------------------------------------------------------
pdf(out_pdf, width = 10, height = 7.5, useDingbats = FALSE)
draw_full_figure()
dev.off()
png(out_png, width = 3200, height = 2400, res = 320)
draw_full_figure()
dev.off()
