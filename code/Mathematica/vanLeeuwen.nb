Cell[BoxData[
 RowBox[{"f", "=", 
  FractionBox[
   RowBox[{
    SubscriptBox["a", "i"], 
    SubscriptBox["\[CapitalNu]", "i"], " ", 
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "n"], 
      RowBox[{
       SubscriptBox["s", 
        RowBox[{"i", " ", "k"}]], 
       SubscriptBox["a", "k"], 
       SubscriptBox["\[CapitalNu]", "k"]}]}], ")"}]}], 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "n"], 
    RowBox[{
     SubscriptBox["a", "k"], 
     SubscriptBox["\[CapitalNu]", "k"], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "1"}], "n"], 
        RowBox[{
         SubscriptBox["s", 
          RowBox[{"k", " ", "j"}]], 
         SubscriptBox["h", 
          RowBox[{"k", " ", "j"}]], 
         SubscriptBox["a", "j"], 
         SubscriptBox["\[CapitalNu]", "j"]}]}]}], ")"}]}]}]]}]], "Input",
